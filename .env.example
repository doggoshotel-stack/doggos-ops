# Copy to .env.local for local development.
# In Vercel, set this in Project Settings → Environment Variables.
# To rotate the password, change this value and redeploy.
VITE_DOGGOS_PASSWORD=doggos2026

# Customer portal (public, /portal) — the Apps Script Web App /exec URL.
# This is only a backend endpoint, not a secret: all auth happens server-side
# inside the Apps Script via signed magic-link tokens.
VITE_PORTAL_API=

# Consent form (public, /consentimiento) — posts to the HubSpot-proxy Apps
# Script Web App, which appends each signed form to the "Consent" tab.
# Both values already ship in the ops dashboard bundle (not secrets); the code
# falls back to the live values, so these are only needed to override for
# staging or after a key rotation.
VITE_HUBSPOT_API=
VITE_HUBSPOT_KEY=
